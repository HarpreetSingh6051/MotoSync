{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/motosync.apk",
      "destination": "/motosync.apk"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
